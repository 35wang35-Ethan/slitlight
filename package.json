{
  "name": "slitlight-cloudflare-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "python scripts/build_admin_public.py",
    "cf:admin:dev": "npm run build:admin && wrangler dev -c wrangler.admin.jsonc",
    "cf:admin:deploy": "npm run build:admin && wrangler deploy -c wrangler.admin.jsonc",
    "cf:dev": "wrangler dev --local",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
