{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slitlight-foundation",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Local foundation only. No remote database has been provisioned.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slitlight-db",
      "migrations_dir": "migrations"
    }
  ]
}
